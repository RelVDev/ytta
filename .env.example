# Rahasia provider hanya disimpan di environment Vercel, jangan di ekstensi.
TOKENHARBOR_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CLIENT_TOKEN=

# Model default. API juga menerima pilihan manual yang dibatasi allowlist.
HARBOR_MODEL=qwen3.8-flash:free
GEMINI_MODEL=gemini-3.8-flash
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_OCR_MODEL=qwen/qwen3.8-27b
GEMINI_THINKING_BUDGET=0

ALLOWED_ORIGINS=
RATE_LIMIT_PER_MIN=20
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOG_LEVEL=info
