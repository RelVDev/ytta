{
  "manifest_version": 3,
  "name": "Form Helper",
  "version": "0.1.1",
  "description": "Saran jawaban untuk membahas soal Google Forms saat belajar.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://docs.google.com/forms/*",
    "https://docs.google.com/forms-images-rt/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.ggpht.com/*",
    "https://*.gstatic.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://docs.google.com/forms/*"],
    "js": ["content/00-utils.js", "content/10-parser.js", "content/20-ui.js", "content/30-main.js"],
    "css": ["content/styles.css"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Form Helper — buka pengaturan di halaman Forms" }
}
